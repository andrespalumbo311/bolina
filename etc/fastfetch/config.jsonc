{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/etc/fastfetch/bolina.txt",
        "color": {
            "1": "white",
            "2": "cyan",
            "3": "blue"
        },
        "padding": {
            "top": 0,
            "right": 2
        }
    },
    "display": {
        "separator": " ➜ ",
        "disableLinewrap": true,
        "key": {
            "width": 10
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        {
            "type": "packages",
            "format": "{rpm} (rpm), {flatpak-all} (flatpak), {brew} (brew)"
        },
        "shell",
        {
            "type": "display",
            "key": "Display",
            "compactType": "original-with-refresh-rate"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        "theme",
        "icons",
        {
            "type": "font",
            "format": "{3}"
        },
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "swap",
        {
            "type": "disk",
            "folders": "/etc",
            "key": "Disk (/)",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "battery",
            "key": "Battery"
        },
        "break",
        "colors"
    ]
}
