{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/etc/fastfetch/bolina.txt",
        "color": {
            "1": "white",
            "2": "cyan",
            "3": "blue"
        },
        "padding": {
            "top": 0,
            "right": 2
        }
    },
    "display": {
        "separator": " ➜ "
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "wm",
        "theme",
        "icons",
        "font",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "battery",
        "break",
        "colors"
    ]
}
